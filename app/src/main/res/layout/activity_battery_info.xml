<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="#F1F3F5"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.BatteryInfoActivity">

    <RelativeLayout
        android:background="@drawable/dialog_shape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/ll_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="54dp"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@mipmap/ic_back" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:text="@string/battery_info"
                android:textColor="@color/title_color"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
        <ImageView
            android:id="@+id/iv"
            android:layout_below="@id/ll_back"
            android:layout_margin="20dp"
            android:src="@mipmap/ic_battery_info"
            android:layout_width="150dp"
            android:layout_height="150dp">
        </ImageView>
        <TextView
            android:id="@+id/tv_temperature_hint"
            android:layout_toRightOf="@id/iv"
            android:layout_below="@id/ll_back"
            android:layout_marginTop="20dp"
            android:text="@string/temperature"
            android:textSize="15sp"
            android:textColor="@color/hint_color"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="25dp">
        </TextView>
        <TextView
            android:id="@+id/tv_temperature"
            android:layout_toRightOf="@id/iv"
            android:layout_below="@id/tv_temperature_hint"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/theme_color"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="50dp">
        </TextView>

        <TextView
            android:id="@+id/tv_percentage_hint"
            android:layout_toRightOf="@id/iv"
            android:layout_below="@id/tv_temperature"
            android:text="@string/percentage"
            android:textSize="15sp"
            android:textColor="@color/hint_color"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="25dp">
        </TextView>
        <TextView
            android:id="@+id/tv_percentage"
            android:layout_toRightOf="@id/iv"
            android:layout_below="@id/tv_percentage_hint"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/title_color"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="50dp">
        </TextView>
        <View
            android:layout_below="@id/tv_percentage"
            android:layout_margin="20dp"
            android:layout_width="match_parent"
            android:layout_height="0.5dp">
        </View>
        <TextView
            android:id="@+id/tv_estimated_battery"
            android:layout_marginTop="40dp"
            android:layout_marginLeft="25dp"
            android:text="@string/estimated_battery"
            android:textStyle="bold"
            android:textColor="@color/title_color"
            android:textSize="18sp"
            android:layout_below="@id/tv_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </TextView>

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_estimated_battery"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="5dp"
            android:textColor="@color/hint_color"
            android:textSize="16sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_estimated_battery"
            android:layout_alignParentRight="true"
            android:layout_marginTop="5dp"
            android:layout_marginRight="20dp"
            android:textColor="@color/hint_color"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginBottom="15dp"
            android:layout_below="@id/tv_time"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"
            android:layout_marginTop="15dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/battery_banner_progress"/>
    </RelativeLayout>
    
    <LinearLayout
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="80dp">
        <RelativeLayout
            android:layout_weight="1"
            android:layout_width="0dp"
            android:background="@drawable/dialog_shape"
            android:layout_height="match_parent">
            <ImageView
                android:src="@mipmap/ic_capacity"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="10dp"
                android:layout_width="40dp"
                android:layout_height="40dp">
            </ImageView>
            <TextView
                android:text="@string/capacity"
                android:gravity="bottom"
                android:textColor="@color/hint_color"
                android:textSize="15sp"
                android:layout_marginLeft="58dp"
                android:layout_width="wrap_content"
                android:layout_height="40dp">
            </TextView>
            <TextView
                android:id="@+id/tv_capacity"
                android:gravity="top"
                android:textColor="@color/title_color"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="58dp"
                android:layout_marginTop="35dp"
                android:layout_width="wrap_content"
                android:layout_height="40dp">
            </TextView>

        </RelativeLayout>
        <RelativeLayout
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/dialog_shape"
            android:layout_height="match_parent">
            <ImageView
                android:src="@mipmap/ic_voltage"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="10dp"
                android:layout_width="40dp"
                android:layout_height="40dp">
            </ImageView>
            <TextView
                android:text="@string/voltage"
                android:gravity="bottom"
                android:textColor="@color/hint_color"
                android:textSize="15sp"
                android:layout_marginLeft="58dp"
                android:layout_width="wrap_content"
                android:layout_height="40dp">
            </TextView>
            <TextView
                android:id="@+id/tv_voltage"
                android:gravity="top"
                android:textColor="@color/title_color"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="58dp"
                android:layout_marginTop="35dp"
                android:layout_width="wrap_content"
                android:layout_height="40dp">
            </TextView>

        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_marginTop="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="80dp">
        <RelativeLayout
            android:layout_weight="1"
            android:layout_width="0dp"
            android:background="@drawable/dialog_shape"
            android:layout_height="match_parent">
            <ImageView
                android:src="@mipmap/ic_health"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="10dp"
                android:layout_width="40dp"
                android:layout_height="40dp">
            </ImageView>
            <TextView
                android:text="@string/health"
                android:gravity="bottom"
                android:textColor="@color/hint_color"
                android:textSize="15sp"
                android:layout_marginLeft="58dp"
                android:layout_width="wrap_content"
                android:layout_height="40dp">
            </TextView>
            <TextView
                android:id="@+id/tv_health"
                android:gravity="top"
                android:textColor="@color/title_color"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="58dp"
                android:layout_marginTop="35dp"
                android:layout_width="wrap_content"
                android:layout_height="40dp">
            </TextView>

        </RelativeLayout>
        <RelativeLayout
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/dialog_shape"
            android:layout_height="match_parent">
            <ImageView
                android:src="@mipmap/ic_type"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="10dp"
                android:layout_width="40dp"
                android:layout_height="40dp">
            </ImageView>
            <TextView
                android:text="@string/type"
                android:gravity="bottom"
                android:textColor="@color/hint_color"
                android:textSize="15sp"
                android:layout_marginLeft="58dp"
                android:layout_width="wrap_content"
                android:layout_height="40dp">
            </TextView>
            <TextView
                android:id="@+id/tv_battrey_type"
                android:gravity="top"
                android:textColor="@color/title_color"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="58dp"
                android:layout_marginTop="35dp"
                android:layout_width="wrap_content"
                android:layout_height="40dp">
            </TextView>

        </RelativeLayout>

    </LinearLayout>
    <Button
        android:id="@+id/bt_got_it"
        android:layout_width="330dp"
        android:layout_height="55dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="25dp"
        android:background="@drawable/btn_selector"
        android:text="@string/got_it"
        android:textAllCaps="false"
        android:textColor="@color/text_seletor"
        android:textSize="20sp" />
</LinearLayout>