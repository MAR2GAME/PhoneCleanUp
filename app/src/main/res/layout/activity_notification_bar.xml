<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F5"
    android:orientation="vertical"
    tools:context=".ui.NotificationBarActivity">
    <RelativeLayout
        android:id="@+id/rl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/top_bg_shape">
        <LinearLayout
            android:id="@+id/ll_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="54dp"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@mipmap/ic_back" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:text="@string/notification_bar"
                android:textColor="@color/title_color"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_settings"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@mipmap/ic_bar_setting"
           android:layout_alignParentRight="true"
            android:layout_marginTop="54dp"
            android:layout_marginRight="20dp"/>
        <TextView
            android:id="@+id/tv_summary_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/title_color"
            android:text="@string/notification_blocking_enabled"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="25dp"
            android:layout_below="@id/ll_back"
            android:layout_width="220dp"
            android:layout_height="wrap_content">
        </TextView>
        <TextView
            android:id="@+id/tv_summary_hint"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/hint_color"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="5dp"
            android:layout_below="@id/tv_summary_title"
            android:layout_width="220dp"
            android:layout_height="wrap_content">
        </TextView>
        
        <ImageView
            android:id="@+id/iv_block"
            android:layout_below="@id/ll_back"
            android:layout_toRightOf="@id/tv_summary_hint"
            android:layout_width="120dp"
            android:src="@mipmap/ic_block"
            android:layout_height="120dp">
        </ImageView>
        <View
            android:layout_below="@id/iv_block"
            android:layout_centerHorizontal="true"
            android:layout_width="match_parent"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:background="#33242424"
            android:layout_marginTop="20dp"
            android:layout_height="0.5dp">
        </View>
        <TextView
            android:layout_below="@id/iv_block"
            android:layout_centerHorizontal="true"
            android:id="@+id/tv_summary_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:textColor="#F5753A"
            android:textSize="28sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_below="@id/tv_summary_count"
            android:layout_centerHorizontal="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/title_color"
            android:textSize="14sp"
            android:layout_marginBottom="20dp"
            android:text="@string/notifications_blocked"
            android:textStyle="bold"/>

    </RelativeLayout>
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/notification_empty"
        android:textColor="@color/main_caption"
        android:textSize="15sp"
        android:visibility="gone"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_notifications"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingEnd="10dp"
        android:paddingStart="10dp"
        android:layout_marginBottom="15dp"/>
    <Button
        android:id="@+id/btn_tidy_up"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="20dp"
        android:background="@drawable/btn_selector"
        android:text="@string/one_tap_tidy_up"
        android:textAllCaps="false"
        android:textColor="@color/text_seletor"
        android:textSize="20sp"
        android:layout_marginBottom="60dp"
        android:textStyle="bold" />
</LinearLayout>