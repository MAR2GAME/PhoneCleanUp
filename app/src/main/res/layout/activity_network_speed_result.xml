<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F5"
    tools:context=".ui.NetworkSpeedResultActivity">
    <LinearLayout
        android:id="@+id/ll_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="54dp"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@mipmap/ic_back" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="5dp"
            android:text="@string/network_speed"
            android:textColor="@color/title_color"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll"
        android:orientation="horizontal"
        android:layout_below="@id/ll_back"
        android:layout_margin="20dp"
        android:layout_width="match_parent"
        android:layout_height="100dp">
        <RelativeLayout
            android:layout_weight="1"
            android:layout_width="0dp"
            android:clipChildren="false"
            android:background="@drawable/dialog_shape"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/iv_download"
                android:src="@mipmap/ic_download"
                android:layout_marginLeft="15dp"
                android:layout_centerVertical="true"
                android:layout_width="45dp"
                android:layout_height="45dp">
            </ImageView>
            <LinearLayout
                android:layout_marginLeft="10dp"
                android:orientation="vertical"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@id/iv_download"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/hint_color"
                    android:text="@string/download"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                </TextView>

                <TextView
                    android:id="@+id/tv_download_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/title_color"
                    android:textSize="28sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mbps"
                    android:textColor="@color/theme_color"
                    android:textSize="15sp" />

            </LinearLayout>






        </RelativeLayout>
        <RelativeLayout
            android:layout_weight="1"
            android:layout_width="0dp"
            android:background="@drawable/dialog_shape"
            android:layout_marginLeft="10dp"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/iv_upload"
                android:src="@mipmap/ic_upload"
                android:layout_marginLeft="15dp"
                android:layout_centerVertical="true"
                android:layout_width="45dp"
                android:layout_height="45dp">
            </ImageView>
            <LinearLayout
                android:layout_marginLeft="10dp"
                android:orientation="vertical"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@id/iv_upload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/hint_color"
                    android:text="@string/upload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                </TextView>
                <TextView
                    android:id="@+id/tv_upload_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/title_color"
                    android:textSize="28sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mbps"
                    android:textColor="@color/theme_color"
                    android:textSize="15sp" />
            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/dialog_shape"
        android:layout_height="160dp">
        <ImageView
            android:id="@+id/iv_task1"
            android:src="@mipmap/ic_nt"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="25dp"
            android:layout_width="50dp"
            android:layout_height="50dp">
        </ImageView>
        <TextView
            android:id="@+id/tv_task1"
            android:layout_toRightOf="@id/iv_task1"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="15dp"
            android:gravity="bottom"
            android:textColor="@color/title_color"
            android:textSize="18sp"
            android:layout_width="match_parent"
            android:layout_height="50dp">
        </TextView>
        <TextView
            android:id="@+id/tv_hint1"
            android:layout_toRightOf="@id/iv_task1"
            android:layout_marginLeft="10dp"
            android:layout_below="@id/tv_task1"
            android:layout_marginRight="15dp"
            android:textColor="@color/hint_color"
            android:textSize="14sp"
            android:layout_width="match_parent"
            android:layout_height="50dp">
        </TextView>
        <TextView
            android:id="@+id/tv_next1"
            android:gravity="center"
            android:textSize="15sp"
            android:textColor="@color/theme_color"
            android:background="@drawable/task_shape"
            android:layout_marginRight="15dp"
            android:layout_alignParentRight="true"
            android:layout_below="@id/tv_hint1"
            android:layout_marginTop="10dp"
            android:layout_width="140dp"
            android:text="@string/check_now"
            android:layout_height="40dp">

        </TextView>
        <ImageView
            android:layout_marginTop="20dp"
            android:layout_marginRight="22dp"
            android:src="@mipmap/ic_task_next"
            android:layout_below="@id/tv_hint1"
            android:layout_alignParentRight="true"
            android:layout_width="20dp"
            android:layout_height="20dp">

        </ImageView>



    </RelativeLayout>


    <RelativeLayout

        android:layout_width="match_parent"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/dialog_shape"
        android:layout_marginTop="10dp"
        android:layout_height="160dp">
        <ImageView
            android:id="@+id/iv_task2"
            android:src="@mipmap/ic_nt"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="25dp"
            android:layout_width="50dp"
            android:layout_height="50dp">
        </ImageView>
        <TextView
            android:id="@+id/tv_task2"
            android:layout_toRightOf="@id/iv_task2"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="15dp"
            android:gravity="bottom"
            android:textColor="@color/title_color"
            android:textSize="18sp"
            android:layout_width="match_parent"
            android:layout_height="50dp">
        </TextView>
        <TextView
            android:id="@+id/tv_hint2"
            android:layout_toRightOf="@id/iv_task2"
            android:layout_marginLeft="10dp"
            android:layout_below="@id/tv_task2"
            android:layout_marginRight="15dp"
            android:textColor="@color/hint_color"
            android:textSize="14sp"
            android:layout_width="match_parent"
            android:layout_height="50dp">
        </TextView>
        <TextView
            android:id="@+id/tv_next2"
            android:gravity="center"
            android:textSize="15sp"
            android:textColor="@color/theme_color"
            android:background="@drawable/task_shape"
            android:layout_marginRight="15dp"
            android:layout_alignParentRight="true"
            android:layout_below="@id/tv_hint2"
            android:layout_marginTop="10dp"
            android:layout_width="140dp"
            android:layout_height="40dp">

        </TextView>
        <ImageView
            android:layout_marginTop="20dp"
            android:layout_marginRight="22dp"
            android:src="@mipmap/ic_task_next"
            android:layout_below="@id/tv_hint2"
            android:layout_alignParentRight="true"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
    </RelativeLayout>





</LinearLayout>