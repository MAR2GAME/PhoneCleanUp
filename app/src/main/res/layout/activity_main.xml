<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainActivity"
    >
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="100dp"
        />
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:background="@drawable/bottom_shape"
        android:layout_height="120dp">
        <RelativeLayout
            android:id="@+id/rl_home"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="80dp">
            <ImageView
                android:id="@+id/ic_home"
                android:src="@mipmap/ic_home_check"
                android:layout_marginTop="12dp"
                android:layout_centerHorizontal="true"
                android:layout_width="32dp"
                android:layout_height="32dp">
            </ImageView>
            <TextView
                android:id="@+id/tv_home"
                android:textSize="15sp"
                android:textColor="@color/theme_color"
                android:text="@string/home"
                android:layout_below="@id/ic_home"
                android:layout_centerHorizontal="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TextView>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_box"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="80dp">
            <ImageView
                android:id="@+id/ic_box"
                android:src="@mipmap/ic_box_nor"
                android:layout_marginTop="12dp"
                android:layout_centerHorizontal="true"
                android:layout_width="32dp"
                android:layout_height="32dp">
            </ImageView>
            <TextView
                android:id="@+id/tv_box"
                android:textSize="15sp"
                android:textColor="@color/hint_color"
                android:text="@string/toolbox"
                android:layout_below="@id/ic_box"
                android:layout_centerHorizontal="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TextView>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_setting"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="80dp">
            <ImageView
                android:id="@+id/ic_setting"
                android:src="@mipmap/ic_setting_nor"
                android:layout_marginTop="12dp"
                android:layout_centerHorizontal="true"
                android:layout_width="32dp"
                android:layout_height="32dp">
            </ImageView>
            <TextView
                android:id="@+id/tv_setting"
                android:textSize="15sp"
                android:textColor="@color/hint_color"
                android:text="@string/settings"
                android:layout_below="@id/ic_setting"
                android:layout_centerHorizontal="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TextView>
        </RelativeLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>