<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F5"
    tools:context=".ui.AppUsageActivity">

    <LinearLayout
        android:id="@+id/ll_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="54dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@mipmap/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="5dp"
            android:text="@string/app_usage"
            android:textColor="@color/title_color"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@id/ll_back"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        app:tabGravity="center"
        app:tabPaddingStart="2dp"
        app:tabPaddingEnd="2dp"
        app:tabIndicatorHeight="0dp"
        app:tabMode="scrollable"
        app:tabRippleColor="@android:color/transparent"
        app:tabBackground="@drawable/tab_bg_selector"
        />


    <LinearLayout
        android:id="@+id/group_usage_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tabLayout"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/dialog_shape"
            android:orientation="horizontal"
            android:padding="18dp">

            <com.cleanphone.freespace.utility.view.AppUsageDonutView
                android:id="@+id/donut_usage"
                android:layout_width="140dp"
                android:layout_height="140dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_summary_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/title_color"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_summary_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/title_color"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/legend_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_height="50dp"
            android:layout_marginEnd="20dp"
            android:layout_marginStart="20dp"
           >

            <TextView
                android:id="@+id/btn_hours_spent"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="@string/hours_spent"
                android:textColor="@color/theme_color"
                android:textSize="16sp"
                android:textStyle="bold" />
            <View
                android:id="@+id/tv_hours_spent_hint"
                android:layout_below="@id/btn_hours_spent"
                android:background="@color/theme_color"
                android:layout_width="160dp"
                android:layout_height="2dp">
            </View>

            <TextView
                android:id="@+id/btn_times_opened"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:layout_toRightOf="@id/btn_hours_spent"
                android:gravity="center"
                android:textColor="#505050"
                android:text="@string/times_opened"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/tv_times_opened_hint"
                android:layout_below="@id/btn_hours_spent"
                android:background="@color/theme_color"
                android:visibility="gone"
                android:layout_toRightOf="@id/btn_hours_spent"
                android:layout_width="160dp"
                android:layout_height="2dp">
            </View>
        </RelativeLayout>

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/app_usage_empty"
            android:textColor="@color/title_color"
            android:textSize="15sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_usage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:layout_marginBottom="50dp"
            android:paddingEnd="20dp"
            android:paddingStart="20dp" />
    </LinearLayout>




</RelativeLayout>