<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F5"
    tools:context=".ui.ScreenShotManagerActivity">

    <LinearLayout
        android:id="@+id/ll_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="50dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_scan_back"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@mipmap/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:text="@string/screenshot_manager"
            android:textColor="@color/title_color"
            android:textSize="20sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_screenshot"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_below="@id/ll_back"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="20dp"
        android:src="@mipmap/ic_shotes"/>

    <TextView
        android:id="@+id/tv_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/ll_back"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="45dp"
        android:layout_toRightOf="@id/iv_screenshot"
        android:textColor="@color/title_color"
        android:textSize="30sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_size"
        android:layout_marginLeft="30dp"
        android:layout_toRightOf="@id/iv_screenshot"
        android:gravity="center_horizontal"
        android:text="@string/total_size"
        android:textColor="@color/title_color"
        android:textSize="18sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/iv_screenshot"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:paddingBottom="60dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rc_screenshot"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp" />

            <RelativeLayout
                android:id="@+id/rl_nodata"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/iv_nodata"
                    android:layout_width="match_parent"
                    android:layout_height="360dp"
                    android:src="@mipmap/ic_nodata" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="300dp"
                    android:text="@string/not_found"
                    android:textColor="#666666"
                    android:textSize="20sp" />
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/rl_select_all"
                android:layout_width="wrap_content"
                android:layout_height="55dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/dialog_shape"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
              >

                <ImageView
                    android:id="@+id/iv_check"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_centerVertical="true"
                    android:src="@mipmap/ic_check_nor" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="5dp"
                    android:layout_toRightOf="@id/iv_check"
                    android:text="@string/select_all"
                    android:textColor="@color/title_color"
                    android:textSize="16sp" />
            </RelativeLayout>

            <Button
                android:id="@+id/bt_delete"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="20dp"
                android:layout_toRightOf="@id/rl_select_all"
                android:background="@drawable/btn_selector"
                android:text="@string/delete"
                android:textAllCaps="false"
                android:textColor="@color/text_seletor"
                android:textSize="18sp" />
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
