<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F5">
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="55dp"
        android:text="@string/app_name"
        android:textColor="@color/title_color"
        android:textSize="20sp"
        android:textStyle="bold"/>
    <LinearLayout
        android:id="@+id/ll_used_space"
        android:orientation="horizontal"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_below="@id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="140dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent">
            <TextView
                android:text="@string/used_space"
                android:gravity="center_vertical"
                android:textSize="17sp"
                android:paddingLeft="10dp"
                android:textColor="@color/title_color"
                android:layout_width="match_parent"
                android:layout_height="40dp">
            </TextView>
            <TextView
                android:id="@+id/tv_memory"
                android:paddingLeft="10dp"
                android:textSize="17sp"
                android:textColor="@color/title_color"
                android:layout_width="match_parent"
                android:layout_height="40dp">
            </TextView>
            <Button
                android:id="@+id/bt_clean"
                android:layout_width="160dp"
                android:layout_height="50dp"
                android:layout_marginLeft="10dp"
                android:background="@drawable/btn_selector"
                android:text="@string/remove_junk"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/text_seletor"
                android:textSize="18sp" />
        </LinearLayout>
        <ImageView
            android:src="@mipmap/ic_home_file"
            android:layout_weight="0.8"
            android:layout_width="0dp"
            android:layout_height="match_parent">
        </ImageView>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_network"
        android:orientation="horizontal"
        android:layout_marginTop="15dp"
        android:layout_below="@id/ll_used_space"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="160dp">
        <RelativeLayout
            android:id="@+id/rl_network_scan"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:background="@drawable/dialog_shape"
            android:layout_height="match_parent">
            <ImageView
                android:src="@mipmap/ic_network_scan"
                android:layout_marginTop="15dp"
                android:layout_marginLeft="15dp"
                android:layout_width="80dp"
                android:layout_height="80dp">
            </ImageView>
            <TextView
                android:text="@string/network_scan"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="110dp"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/title_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

            </TextView>

        </RelativeLayout>
        <LinearLayout
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:orientation="vertical"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/rl_network_speed"
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:background="@drawable/dialog_shape"
                android:layout_height="0dp">
                <ImageView
                    android:src="@mipmap/ic_speed"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="15dp"
                    android:layout_width="40dp"
                    android:layout_height="40dp">
                </ImageView>
                <TextView
                    android:text="@string/network_speed"
                    android:layout_marginLeft="65dp"
                    android:layout_centerVertical="true"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/title_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                </TextView>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_network_usage"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:background="@drawable/dialog_shape"
                android:layout_height="0dp">
                <ImageView
                    android:src="@mipmap/ic_neteork_usage"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="15dp"
                    android:layout_width="40dp"
                    android:layout_height="40dp">
                </ImageView>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="@string/network_usage"
                    android:layout_marginLeft="65dp"
                    android:layout_centerVertical="true"
                    android:textColor="@color/title_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                </TextView>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rl_app_usage"
        android:layout_below="@id/ll_network"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_width="match_parent"
        android:background="@drawable/dialog_shape"
        android:layout_height="75dp">

        <ImageView
            android:src="@mipmap/ic_app"
            android:layout_centerVertical="true"
            android:layout_marginLeft="15dp"
            android:layout_width="50dp"
            android:layout_height="50dp">
        </ImageView>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="@string/app_usage"
            android:layout_marginLeft="80dp"
            android:layout_centerVertical="true"
            android:textColor="@color/title_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </TextView>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rl_notification_bar"
        android:layout_below="@id/rl_app_usage"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_width="match_parent"
        android:background="@drawable/dialog_shape"
        android:layout_height="75dp">

        <ImageView
            android:src="@mipmap/ic_nt"
            android:layout_centerVertical="true"
            android:layout_marginLeft="15dp"
            android:layout_width="50dp"
            android:layout_height="50dp">
        </ImageView>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="@string/notification_bar"
            android:layout_marginLeft="80dp"
            android:layout_centerVertical="true"
            android:textColor="@color/title_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </TextView>
    </RelativeLayout>

    




    
    


</RelativeLayout>