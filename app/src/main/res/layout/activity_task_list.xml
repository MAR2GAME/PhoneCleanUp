<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="#F1F3F5"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.TaskListActivity">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="30dp"
        android:background="@drawable/top_bg_shape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/ll_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="54dp"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@mipmap/ic_back" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:text="@string/back"
                android:textColor="@color/title_color"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
        <ImageView
            android:layout_marginTop="30dp"
            android:src="@mipmap/ic_finish"
            android:layout_gravity="center_horizontal"
            android:layout_width="80dp"
            android:layout_height="80dp">
        </ImageView>
        <TextView
            android:id="@+id/tv_title"
            android:text="@string/task_complete"
            android:textSize="18sp"
            android:textColor="@color/title_color"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </TextView>

        <TextView
            android:id="@+id/tv_hint"
            android:layout_marginTop="15dp"
            android:text="@string/task_complete"
            android:textSize="16sp"
            android:visibility="gone"
            android:textColor="@color/hint_color"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </TextView>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:background="@drawable/dialog_shape"
        android:layout_marginTop="15dp"
        android:layout_height="160dp">
        <ImageView
            android:id="@+id/iv_task1"
            android:src="@mipmap/ic_nt"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="25dp"
            android:layout_width="50dp"
            android:layout_height="50dp">
        </ImageView>
        <TextView
            android:id="@+id/tv_task1"
            android:layout_toRightOf="@id/iv_task1"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="15dp"
            android:gravity="bottom"
            android:textColor="@color/title_color"
            android:textSize="18sp"
            android:layout_width="match_parent"
            android:layout_height="50dp">
        </TextView>
        <TextView
            android:id="@+id/tv_hint1"
            android:layout_toRightOf="@id/iv_task1"
            android:layout_marginLeft="10dp"
            android:layout_below="@id/tv_task1"
            android:layout_marginRight="15dp"
            android:textColor="@color/hint_color"
            android:textSize="14sp"
            android:layout_width="match_parent"
            android:layout_height="50dp">
        </TextView>
        <TextView
            android:id="@+id/tv_next1"
            android:gravity="center"
            android:textSize="15sp"
            android:textColor="@color/theme_color"
            android:background="@drawable/task_shape"
            android:layout_marginRight="15dp"
            android:layout_alignParentRight="true"
            android:layout_below="@id/tv_hint1"
            android:layout_marginTop="10dp"
            android:layout_width="140dp"
            android:text="@string/check_now"
            android:layout_height="40dp">

        </TextView>
        <ImageView
            android:layout_marginTop="23dp"
            android:layout_marginRight="22dp"
            android:src="@mipmap/ic_task_next"
            android:layout_below="@id/tv_hint1"
            android:layout_alignParentRight="true"
            android:layout_width="15dp"
            android:layout_height="15dp">

        </ImageView>



    </RelativeLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:background="@drawable/dialog_shape"
        android:layout_marginTop="10dp"
        android:layout_height="160dp">
        <ImageView
            android:id="@+id/iv_task2"
            android:src="@mipmap/ic_nt"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="25dp"
            android:layout_width="50dp"
            android:layout_height="50dp">
        </ImageView>
        <TextView
            android:id="@+id/tv_task2"
            android:layout_toRightOf="@id/iv_task2"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="15dp"
            android:gravity="bottom"
            android:textColor="@color/title_color"
            android:textSize="18sp"
            android:layout_width="match_parent"
            android:layout_height="50dp">
        </TextView>
        <TextView
            android:id="@+id/tv_hint2"
            android:layout_toRightOf="@id/iv_task2"
            android:layout_marginLeft="10dp"
            android:layout_below="@id/tv_task2"
            android:layout_marginRight="15dp"
            android:textColor="@color/hint_color"
            android:textSize="14sp"
            android:layout_width="match_parent"
            android:layout_height="50dp">
        </TextView>
        <TextView
            android:id="@+id/tv_next2"
            android:gravity="center"
            android:textSize="15sp"
            android:textColor="@color/theme_color"
            android:background="@drawable/task_shape"
            android:layout_marginRight="15dp"
            android:layout_alignParentRight="true"
            android:layout_below="@id/tv_hint2"
            android:layout_marginTop="10dp"
            android:layout_width="140dp"
            android:layout_height="40dp">

        </TextView>
        <ImageView
            android:layout_marginTop="23dp"
            android:layout_marginRight="22dp"
            android:src="@mipmap/ic_task_next"
            android:layout_below="@id/tv_hint2"
            android:layout_alignParentRight="true"
            android:layout_width="15dp"
            android:layout_height="15dp"/>
    </RelativeLayout>
</LinearLayout>