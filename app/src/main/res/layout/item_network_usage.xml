<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="140dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:background="@drawable/dialog_shape" />

    <ImageView
        android:id="@+id/iv_app_icon"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="15dp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_toRightOf="@id/iv_app_icon"
        android:gravity="center_vertical"
        android:textColor="@color/title_color"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/tv_app_name"
        android:layout_marginLeft="10dp"
        android:layout_toRightOf="@id/iv_app_icon"
        android:background="#33242424"/>

    <TextView
        android:id="@+id/tv_usage_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_app_name"
        android:layout_toRightOf="@id/iv_app_icon"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="5dp"
        android:textColor="@color/main_caption"
        android:textSize="14sp" />
        <ProgressBar
            android:id="@+id/progress_usage"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_below="@id/tv_usage_value"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:layout_toRightOf="@id/iv_app_icon"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:max="100"
            android:progressDrawable="@drawable/usage_progress_drawable" />
</RelativeLayout>
